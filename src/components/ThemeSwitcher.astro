---
import {
  win7PaintColors,
  customSlotCount,
} from '../config/theme.config';
import { siteConfig } from '../config/site.config';
import { getUi } from '../i18n/ui';
const ui = getUi(siteConfig.lang);
const customSlots = Array.from({ length: customSlotCount }, (_, idx) => idx);
---
<section class="widget theme-widget" aria-label={ui.themeTitle} data-theme-switcher>
  <div class="theme-dock">
    <button
      type="button"
      class="button theme-circle-btn theme-toggle-btn"
      data-palette-toggle
      aria-expanded="false"
      aria-controls="aero-paint-palette"
      aria-label={ui.openPalette}
      title={ui.openPalette}
    >
      <svg class="theme-btn-svg" viewBox="2 3 30 25" width="24" height="24" aria-hidden="true">
        <defs>
          <linearGradient id="aero-board-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#f6fbff" />
            <stop offset="55%" stop-color="#dce9f5" />
            <stop offset="100%" stop-color="#b8cde0" />
          </linearGradient>
          <linearGradient id="aero-brush-wood" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#f3b664" />
            <stop offset="100%" stop-color="#c47122" />
          </linearGradient>
        </defs>
        <path
          d="M15.5 4.5C9.2 4.5 4 9.2 4 15.2c0 5.8 4.9 10.3 11 10.3 2 0 3.3-1 3.3-2.5 0-.8-.4-1.5-.8-2.1-.4-.6-.6-1.2-.6-1.8 0-1.4 1.1-2.4 2.6-2.4h1.9c3.6 0 6.6-2.7 6.6-6.2 0-3.5-5.6-6-12.5-6z"
          fill="url(#aero-board-grad)"
          stroke="#4f6b82"
          stroke-width="1.3"
        />
        <circle cx="9.8" cy="12.2" r="2" fill="#ed1c24" />
        <circle cx="14.5" cy="9.2" r="2" fill="#fff200" stroke="#b8a400" stroke-width="0.4" />
        <circle cx="19.8" cy="10.2" r="2" fill="#22b14c" />
        <circle cx="10.2" cy="17.8" r="2" fill="#00a2e8" />
        <circle cx="15.2" cy="21.2" r="1.4" fill="#88a2b8" />
        <path
          d="M20.5 18.2L27.8 7.5c.6-.8 1.7-.9 2.3-.3.6.6.4 1.7-.3 2.4L22.5 20.2z"
          fill="url(#aero-brush-wood)"
          stroke="#7c4310"
          stroke-width="0.9"
        />
        <path
          d="M17.2 21.8c1.1-2.1 2.2-2.6 3.5-3.4l1.8 1.8c-.9 1.4-2.1 2.5-5.3 1.6z"
          fill="#2aa7eb"
          stroke="#156799"
          stroke-width="0.7"
        />
      </svg>
    </button>

    <button
      type="button"
      class="button theme-circle-btn theme-reset-btn"
      data-palette-reset
      aria-label={ui.resetTheme}
      title={ui.resetTheme}
    >
      <svg class="theme-btn-svg" viewBox="4 4 24 24" width="24" height="24" aria-hidden="true">
        <defs>
          <radialGradient id="aero-red-orb" cx="35%" cy="30%" r="70%">
            <stop offset="0%" stop-color="#ff9a9a" />
            <stop offset="45%" stop-color="#df2525" />
            <stop offset="90%" stop-color="#8f0707" />
            <stop offset="100%" stop-color="#610000" />
          </radialGradient>
        </defs>
        <circle cx="16" cy="16" r="11" fill="url(#aero-red-orb)" stroke="#5a0000" stroke-width="1.2" />
        <ellipse cx="16" cy="10.5" rx="7.5" ry="3.8" fill="rgba(255,255,255,0.42)" />
        <path
          d="M11.8 11.8l8.4 8.4M20.2 11.8l-8.4 8.4"
          stroke="#ffffff"
          stroke-width="2.5"
          stroke-linecap="round"
        />
      </svg>
    </button>
  </div>

  <div class="theme-accordion" id="aero-paint-palette" data-palette-accordion hidden>
    <div class="theme-accordion-inner">
      <div class="win7-window glass" role="region" aria-labelledby="theme-title">
        <div class="win7-title-bar">
          <div class="win7-title-bar-text" id="theme-title">{ui.themeTitle}</div>
          <div class="win7-title-bar-controls">
            <button
              type="button"
              class="win7-close-btn"
              data-palette-close
              aria-label={ui.closePalette}
              title={ui.closePalette}
            ></button>
          </div>
        </div>

        <div class="win7-window-body">
          <div class="paint-ribbon">
            <div class="paint-top-bar">
              <div class="paint-color1-slot" title={ui.color1Label}>
                <span class="paint-color1-swatch" data-color1-swatch aria-hidden="true"></span>
                <span class="paint-color1-label">{ui.color1Label}</span>
              </div>
            </div>

            <div class="paint-grid-section">
              <div class="paint-swatch-grid" role="group" aria-label={ui.basicColorsLabel}>
                {win7PaintColors.map((hex) => (
                  <button
                    type="button"
                    class="paint-swatch-cell"
                    data-paint-color={hex}
                    style={`--swatch-color: ${hex}`}
                    aria-label={hex}
                    aria-pressed="false"
                    title={hex}
                  >
                    <span class="paint-swatch-inner" aria-hidden="true"></span>
                  </button>
                ))}
                {customSlots.map((slotIndex) => (
                  <button
                    type="button"
                    class="paint-swatch-cell is-custom-slot is-empty"
                    data-custom-slot={slotIndex}
                    aria-label={ui.emptyCustomSlot(slotIndex + 1)}
                    aria-pressed="false"
                    title={ui.emptyCustomSlot(slotIndex + 1)}
                  >
                    <span class="paint-swatch-inner" aria-hidden="true"></span>
                  </button>
                ))}
              </div>
            </div>

            <div class="paint-footer-bar">
              <label class="win7-btn paint-edit-colors-btn" data-edit-colors-trigger>
                <svg class="paint-edit-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <rect x="2" y="2" width="9" height="9" fill="#ed1c24" stroke="#555" stroke-width="1" />
                  <rect x="13" y="2" width="9" height="9" fill="#22b14c" stroke="#555" stroke-width="1" />
                  <rect x="2" y="13" width="9" height="9" fill="#00a2e8" stroke="#555" stroke-width="1" />
                  <rect x="13" y="13" width="9" height="9" fill="#fff200" stroke="#555" stroke-width="1" />
                </svg>
                <span>{ui.editColorsLabel}</span>
                <input
                  id="aero-custom-color"
                  type="color"
                  class="sr-only"
                  data-custom-color-input
                  value="#3c7fb1"
                  aria-label={ui.editColorsLabel}
                />
              </label>
              <button type="button" class="win7-btn paint-clear-slot-btn" data-clear-slot disabled>{ui.clearColorSlot}</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <span class="sr-only" role="status" aria-live="polite" data-theme-status></span>
</section>
<script>
  import '../scripts/theme';
</script>
