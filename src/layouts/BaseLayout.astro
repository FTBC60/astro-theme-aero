---
import 'remixicon/fonts/remixicon.css';
import '../styles/style.scss';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { siteConfig } from '../config/site.config';
import { getUi } from '../i18n/ui';
import { themeConfig, themeStorageKey } from '../config/theme.config';
import { normalizeThemeColor, deriveThemeColors, applyThemeColors } from '../scripts/theme-colors';
import { withBase } from '../scripts/paths';
import { ClientRouter } from 'astro:transitions';
interface Props { title?: string; description?: string }
const { title, description = siteConfig.subtitle } = Astro.props;
const pageTitle = title ? `${title} | ${siteConfig.title}` : siteConfig.title;
const ui = getUi(siteConfig.lang);
const defaultColor = normalizeThemeColor(themeConfig.defaultColor);
if (!defaultColor) throw new Error('themeConfig.defaultColor must be a six-digit HEX color, such as #3C7FB1.');
const defaultTokens = Object.entries(deriveThemeColors(defaultColor))
  .map(([name, value]) => `${name}: ${value}`).join('; ');
const themeInit = `
(function(normalize, derive, apply) {
  const root = document.documentElement;
  let color = root.dataset.aeroDefaultColor;
  try {
    color = normalize(localStorage.getItem(root.dataset.aeroStorageKey)) || color;
  } catch {}
  apply(root, color, derive(color, getComputedStyle(root).getPropertyValue('--white-main')));
})(${normalizeThemeColor.toString()}, ${deriveThemeColors.toString()}, ${applyThemeColors.toString()});
`;
---
<!doctype html>
<html
  lang={siteConfig.lang}
  data-aero-color={defaultColor}
  data-aero-default-color={defaultColor}
  data-aero-storage-key={themeStorageKey}
  style={`${defaultTokens}; --bg-image: url(${JSON.stringify(withBase(themeConfig.wallpaper))}); --bg-position: ${themeConfig.wallpaperPosition}`}
>
  <head>
    <meta charset="UTF-8" />
    <script is:inline set:html={themeInit}></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" href={withBase(siteConfig.favicon)} />
    <title>{pageTitle}</title>
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <div class="container">
      <Header />
      <button class="button mobile-menu-btn" id="mobile-menu-btn" type="button" aria-label={ui.openSidebar} aria-controls="sidebar" aria-expanded="false">
        <span class="menu-icon ri-menu-fill" aria-hidden="true"></span>
      </button>
      <div class="main-layout">
        <Sidebar />
        <main id="main-content"><slot /></main>
        <div class="sidebar-mask" id="sidebar-mask" aria-hidden="true"></div>
      </div>
      <Footer />
    </div>
    <script>
      import '../scripts/sidebar';
    </script>
  </body>
</html>
